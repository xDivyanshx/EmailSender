# Ignore local tooling
local.settings.json

# The resources/ directory is the app's runtime DATA directory: per-company
# email templates, recipient CSVs, resume attachments and OAuth state. It is
# not code, so it is not versioned here. It lives in its own separate private
# repository instead.
#
# The app still needs it on disk at this path — removing this line from
# .gitignore does NOT restore the files. See appsettings.exmaple.json for the
# layout the app expects.
resources/
*google-oauth-client*.json
*google-token*.json
EmailSender/appsettings.json
**/appsettings.json
**/client_secret*.json
**/credentials*.json
**/*oauth*.json
**/*token*.json

# Local dev screenshots. This one captures the running app and therefore shows
# campaign names, the connected Gmail address and attachment filenames — job
# search detail, not code. Kept out of the index deliberately.
Screenshot*.png
screenshot*.png
